    font-family: Arial, sans-serif;
    font-size: 8.0pt;
    font-weight: bold;
    color: #0f2438;
    text-transform: uppercase;
    letter-spacing: 0.3pt;
    border-bottom: 1pt solid #0d9488;
    padding-bottom: 1pt;
    margin-top: 4pt;
    margin-bottom: 2pt;
}
.summary-box {
    background-color: #f8fafc;
    border-left: 2.5pt solid #0d9488;
    padding: 3pt 6pt;
