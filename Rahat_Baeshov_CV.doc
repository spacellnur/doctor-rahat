    margin: 0;
}
.badge-score {
    background-color: #0d9488;
    color: #ffffff;
    font-weight: bold;
    font-size: 6.5pt;
    padding: 1pt 3pt;
    display: inline-block;
    margin-top: 1pt;
}
.name-header {
    font-family: Arial, sans-serif;
    font-size: 13.5pt;
    font-weight: bold;
    color: #0f2438;
    text-transform: uppercase;
